{
  "colors": {
    "background": "#FAFAF8",
    "foreground": "#1A1A1A",
    "primary": "#B8860B",
    "secondary": "#F5F3F0",
    "accent": "#B8860B",
    "muted": "#F5F3F0",
    "border": "#E8E4DF",
    "card": "#FFFFFF"
  },
  "typography": {
    "fontFamily": {
      "display": "'Playfair Display', serif",
      "sans": "'Source Sans 3', sans-serif",
      "mono": "'IBM Plex Mono', monospace"
    },
    "fontWeights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "section-py-desktop": "py-32",
    "section-py-mobile": "py-20"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "2px",
    "md": "4px",
    "lg": "8px"
  },
  "transitions": {
    "default": "200ms ease-out"
