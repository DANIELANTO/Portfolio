{
  "colors": {
    "background": "#F7F3EF",
    "background-secondary": "#EAE0D4",
    "foreground": "#2B2A28",
    "primary": "#8B6E4D",
    "secondary": "#A68D68",
    "accent": "#CBBCAB",
    "muted": "#EAE0D4",
    "border": "#CBBCAB",
    "card": "#FFFFFF"
  },
  "typography": {
    "fontFamily": {
      "display": "'Playfair Display', serif",
      "sans": "'Inter', sans-serif"
    },
    "fontWeights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "section-py": "py-32",
    "card-padding": "2rem"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem"
  },
  "transitions": {
    "default": "300ms ease-in-out"
  }
}
